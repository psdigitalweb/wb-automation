# Wildberries API Configuration
WB_TOKEN=replace_with_wildberries_api_token
WB_ENDPOINT=https://content-api.wildberries.ru/content/v2/get/cards/list
WB_PAGE_SIZE=100
WB_MAX_PAGES=

# Database Configuration
DATABASE_URL=postgresql+psycopg://wb:wbpassword@db:5432/wb
POSTGRES_USER=wb
POSTGRES_PASSWORD=wbpassword
POSTGRES_DB=wb

# WB card content history (enable per project after migrations/backfill)
WB_CONTENT_HISTORY_ENABLED=false
WB_MAIN_PHOTO_ARCHIVE_ENABLED=false
WB_SHOWCASE_PRESENCE_ENABLED=false
WB_CONTENT_HISTORY_PROJECT_ALLOWLIST=
WB_CONTENT_MEDIA_DIR=/data/wb-content-history
WB_CONTENT_MEDIA_MAX_FILE_SIZE_MB=20
WB_CONTENT_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=20
WB_SHOWCASE_INACTIVE_AFTER_MISSING_RUNS=2

# Project marketplace token encryption (host paths consumed by Docker Compose)
# Production: use an absolute path outside the repository, mode 0600.
PROJECT_SECRETS_KEY_HOST_PATH=
# Set only while following docs/security/project-secrets-key-rotation.md.
PROJECT_SECRETS_PREVIOUS_KEY_HOST_PATH=

# Project proxy secrets (for WB storefront proxy password encryption)
# Use Fernet key (base64 urlsafe 32 bytes). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROJECT_PROXY_SECRET_KEY=
# Production host path consumed by Docker Compose; keep outside the repository.
PROJECT_PROXY_SECRET_KEY_HOST_PATH=
# WB funnel report import / CTR quality
WB_FUNNEL_REPORT_MAX_UPLOAD_BYTES=20971520
WB_FUNNEL_CTR_MISMATCH_TOLERANCE_PP=1
WB_FUNNEL_CTR_INDICATIVE_IMPRESSIONS=100
WB_FUNNEL_CTR_RELIABLE_IMPRESSIONS=400
WB_FUNNEL_CTR_HIGH_SAMPLE_IMPRESSIONS=1000
WB_FUNNEL_CTR_RECOMMENDED_ACTIVE_DAYS=7

# Manual-only customer-opinion analysis through OpenRouter.
# Opening a product page never triggers a model request.
WB_REVIEW_OPINION_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REVIEW_MODEL=openai/gpt-5.6-terra
OPENROUTER_REVIEW_REASONING_EFFORT=medium
OPENROUTER_REVIEW_TIMEOUT_SECONDS=120
OPENROUTER_COMPETITOR_NANO_MODEL=openai/gpt-5-nano
OPENROUTER_COMPETITOR_TERRA_MODEL=openai/gpt-5.6-terra
WB_COMPETITOR_ANALYSIS_ENABLED=false
# Optional outbound proxy used only for OpenRouter.
OPENROUTER_PROXY_URL=
